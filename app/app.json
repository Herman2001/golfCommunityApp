{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
    [
      "expo-image-picker",
      {
        "photosPermission": "Appen behöver tillgång till dina bilder så att du kan lägga till dem i inlägg.",
        "cameraPermission": "Appen behöver tillgång till kameran så att du kan fotografera till inlägg."
      }
    ]
  ]
  }
}
